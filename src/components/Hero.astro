---
---

<section class="hero" id="hero" aria-label="Hero Banner">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__grid"></div>
    <div class="hero__glow"></div>
    <div class="hero__orb hero__orb--green"></div>
    <div class="hero__orb hero__orb--orange"></div>
  </div>

  <div class="container hero__container">

    <!-- LEFT: Content -->
    <div class="hero__content">
      <div class="hero__badge">
        <span class="hero__badge-dot"></span>
        IT Support Outsource นนทบุรี
      </div>

      <h1 class="hero__title">
        บริการดูแลระบบ<br />
        <span class="hero__title-green">คอมพิวเตอร์ครบวงจร</span><br />
        <span class="hero__title-thai">ไทรน้อย บางบัวทอง บางใหญ่ บางกรวย</span>
      </h1>

      <p class="hero__desc">
        BizGrow Tech ให้บริการดูแลระบบคอมพิวเตอร์ เซิร์ฟเวอร์ และเครือข่ายสำหรับองค์กร
        <strong>แบบรายเดือน</strong> เน้นให้บริการรวดเร็วในพื้นที่ นนทบุรี (ไทรน้อย บางบัวทอง บางใหญ่ บางกรวย) ช่วยลดปัญหา Downtime ปกป้องข้อมูล และแก้ไขปัญหาไอทีโดยทีมผู้เชี่ยวชาญ
      </p>

      <div class="hero__stats" role="list">
        <div class="hero__stat" role="listitem">
          <span class="hero__stat-num">30 นาที</span>
          <span class="hero__stat-label">SLA Response Time</span>
        </div>
        <div class="hero__stat-divider" aria-hidden="true"></div>
        <div class="hero__stat" role="listitem">
          <span class="hero__stat-num">4 อำเภอ</span>
          <span class="hero__stat-label">พื้นที่ให้บริการ</span>
        </div>
        <div class="hero__stat-divider" aria-hidden="true"></div>
        <div class="hero__stat" role="listitem">
          <span class="hero__stat-num">99.9%</span>
          <span class="hero__stat-label">Uptime</span>
        </div>
      </div>

      <div class="hero__actions">
        <a href="#contact" class="btn btn-primary hero__cta-main">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.18 2 2 0 012 .01h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92z"/>
          </svg>
          ปรึกษาปัญหาไอทีฟรี
        </a>
        <a href="#packages" class="btn btn-outline">
          ดูแพ็กเกจบริการ
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Area row instead of trust row -->
      <div class="hero__trust">
        <span class="hero__area-icon" aria-hidden="true">📍</span>
        <p class="hero__trust-text">
          บริการ On-site เฉพาะโซน <strong>ไทรน้อย · บางบัวทอง · บางใหญ่ · บางกรวย</strong>
        </p>
      </div>
    </div>

    <!-- RIGHT: Image -->
    <div class="hero__visual">
      <!-- Main hero image -->
      <div class="hero__img-main-wrap">
        <img
          src="/hero-server.webp"
          alt="วิศวกรไอที BizGrow Tech กำลังดูแลระบบ Server ใน Data Center"
          class="hero__img-main"
          width="900"
          height="600"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <!-- Floating card: SLA badge -->
        <div class="hero__float-card hero__float-card--sla">
          <div class="hero__float-icon">⚡</div>
          <div>
            <div class="hero__float-title">Response Time</div>
            <div class="hero__float-val">ภายใน 30 นาที</div>
          </div>
        </div>
        <!-- Floating card: monitoring -->
        <div class="hero__float-card hero__float-card--monitor">
          <div class="hero__float-icon hero__float-dot-wrap">
            <span class="hero__float-dot"></span>
          </div>
          <div>
            <div class="hero__float-title">System Status</div>
            <div class="hero__float-val hero__float-green">All Systems Normal</div>
          </div>
        </div>
      </div>

      <!-- Mini image: on-site support -->
      <div class="hero__img-sub-wrap">
        <img
          src="/onsite-support.webp"
          alt="ช่างไอที BizGrow Tech ให้บริการ On-site support"
          class="hero__img-sub"
          width="200"
          height="200"
          loading="lazy"
          decoding="async"
        />
        <div class="hero__img-sub-label">On-site Support</div>
      </div>
    </div>

  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 7rem 0 4rem;
  }

  /* === Backgrounds === */
  .hero__bg { position: absolute; inset: 0; pointer-events: none; z-index: 0; }

  .hero__grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(107,190,40,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(107,190,40,0.05) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, black 30%, transparent 100%);
  }

  .hero__glow {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 60% 60% at 10% 20%, rgba(107,190,40,0.1) 0%, transparent 60%),
      radial-gradient(ellipse 50% 40% at 90% 80%, rgba(245,146,28,0.08) 0%, transparent 55%);
  }

  .hero__orb { position: absolute; border-radius: 50%; filter: blur(100px); }
  .hero__orb--green { width: 500px; height: 500px; background: #6BBE28; opacity: 0.07; top: -200px; left: -100px; }
  .hero__orb--orange { width: 350px; height: 350px; background: #F5921C; opacity: 0.07; bottom: -80px; right: 100px; }

  /* === Two-column layout === */
  .hero__container {
    position: relative; z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  /* === LEFT: Content === */
  .hero__content { display: flex; flex-direction: column; gap: 1.75rem; }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(107,190,40,0.08);
    border: 1px solid rgba(107,190,40,0.22);
    color: var(--color-green-light);
    padding: 0.35rem 1rem;
    border-radius: 50px;
    font-family: var(--font-en);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    align-self: flex-start;
  }

  .hero__badge-dot {
    width: 7px; height: 7px;
    background: var(--color-green);
    border-radius: 50%;
    animation: pulse-green 2.5s ease infinite;
  }

  @keyframes pulse-green {
    0%, 100% { box-shadow: 0 0 0 0 rgba(107,190,40,0.5); }
    50% { box-shadow: 0 0 0 5px rgba(107,190,40,0); }
  }

  .hero__title {
    font-size: clamp(1.9rem, 3.5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .hero__title-green {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__title-thai {
    font-family: var(--font-en);
    font-size: 0.6em;
    font-weight: 600;
    color: var(--color-text-muted);
    -webkit-text-fill-color: initial;
  }

  .hero__desc {
    font-size: 1.02rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    max-width: 480px;
    margin: 0;
  }
  .hero__desc strong { color: var(--color-text); font-weight: 600; }

  /* Stats */
  .hero__stats {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  .hero__stat { text-align: left; }

  .hero__stat-num {
    display: block;
    font-family: var(--font-en);
    font-size: 1.5rem;
    font-weight: 800;
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
  }

  .hero__stat-label {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-dim);
    margin-top: 0.1rem;
  }

  .hero__stat-divider {
    width: 1px; height: 36px;
    background: linear-gradient(to bottom, transparent, rgba(107,190,40,0.25), transparent);
  }

  /* Actions */
  .hero__actions {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .hero__cta-main { font-size: 1rem; padding: 0.9rem 2rem; }

  /* Trust row */
  .hero__trust {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(107,190,40,0.1);
  }

  .hero__trust-avatars { display: flex; }

  .hero__avatar {
    width: 32px; height: 32px;
    border-radius: 50%;
    border: 2px solid var(--color-dark);
    display: flex; align-items: center; justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
    margin-left: -8px;
  }
  .hero__trust-avatars .hero__avatar:first-child { margin-left: 0; }

  .hero__trust-text {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .hero__trust-text strong { color: var(--color-green-light); }

  /* === RIGHT: Visual === */
  .hero__visual {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-end;
  }

  /* Main image */
  .hero__img-main-wrap {
    position: relative;
    width: 100%;
    max-width: 580px;
    border-radius: 20px;
    overflow: visible;
  }

  .hero__img-main {
    width: 100%;
    height: auto;
    border-radius: 20px;
    object-fit: cover;
    box-shadow:
      0 0 0 1px rgba(107,190,40,0.2),
      0 24px 60px rgba(0,0,0,0.6),
      0 0 80px rgba(107,190,40,0.08);
    display: block;
  }

  /* Image glow edge */
  .hero__img-main-wrap::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: 21px;
    background: linear-gradient(135deg, rgba(107,190,40,0.3) 0%, rgba(245,146,28,0.15) 100%);
    z-index: -1;
    filter: blur(8px);
  }

  /* Floating cards */
  .hero__float-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: rgba(13, 18, 9, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(107,190,40,0.2);
    border-radius: 12px;
    padding: 0.65rem 1rem;
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
    min-width: 170px;
    z-index: 10;
  }

  .hero__float-card--sla {
    top: 1.5rem;
    left: -1.5rem;
    animation: floatUp 4s ease-in-out infinite;
  }

  .hero__float-card--monitor {
    bottom: 2rem;
    right: -1.5rem;
    animation: floatUp 4s ease-in-out infinite 2s;
  }

  @keyframes floatUp {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .hero__float-icon {
    font-size: 1.4rem;
    flex-shrink: 0;
    width: 36px; height: 36px;
    background: rgba(107,190,40,0.12);
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
  }

  .hero__float-dot-wrap { position: relative; }

  .hero__float-dot {
    display: block;
    width: 10px; height: 10px;
    background: var(--color-green);
    border-radius: 50%;
    margin: auto;
    animation: pulse-green 2s infinite;
  }

  .hero__float-title {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .hero__float-val {
    font-family: var(--font-en);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 0.1rem;
  }

  .hero__float-green { color: var(--color-green-light) !important; }

  /* Sub image */
  .hero__img-sub-wrap {
    position: absolute;
    bottom: -1.5rem;
    left: -2rem;
    width: 160px;
    z-index: 20;
  }

  .hero__img-sub {
    width: 160px;
    height: 160px;
    object-fit: cover;
    border-radius: 16px;
    border: 3px solid var(--color-dark);
    box-shadow:
      0 0 0 1px rgba(245,146,28,0.3),
      0 12px 40px rgba(0,0,0,0.5);
    outline: 2px solid rgba(245,146,28,0.2);
  }

  .hero__img-sub-label {
    text-align: center;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-orange-light);
    margin-top: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  /* === Responsive === */
  @media (max-width: 1024px) {
    .hero__container { grid-template-columns: 1fr; gap: 3rem; }
    .hero__content { align-items: center; text-align: center; }
    .hero__badge { align-self: center; }
    .hero__desc { margin: 0 auto; }
    .hero__stats { justify-content: center; }
    .hero__actions { justify-content: center; }
    .hero__trust { justify-content: center; }
    .hero__visual { align-items: center; }
    .hero__img-main-wrap { max-width: 520px; }
    .hero__float-card--sla { left: 0; }
    .hero__float-card--monitor { right: 0; }
    .hero__img-sub-wrap { left: 0; bottom: -1rem; }
  }

  @media (max-width: 600px) {
    .hero { padding: 6rem 0 4rem; }
    .hero__float-card { display: none; }
    .hero__img-sub-wrap { display: none; }
    .hero__actions { flex-direction: column; align-items: center; }
    .btn { width: 100%; max-width: 300px; justify-content: center; }
  }
</style>
