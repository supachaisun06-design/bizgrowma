---
// FAQ Section - AEO (Answer Engine Optimization) + FAQ Schema
// คำถามเขียนในรูปแบบ Voice Search / Natural Language
const faqs = [
  {
    q: "บริการ IT Support Outsource รายเดือน เหมาะกับธุรกิจประเภทใด?",
    a: "เหมาะสำหรับธุรกิจ SME ทุกประเภท ไม่ว่าจะเป็น ร้านค้า คลินิก ออฟฟิศ โรงงาน หรือบริษัทนำเข้า-ส่งออก ที่ไม่มีแผนก IT ประจำ หรือต้องการลดต้นทุนการจ้าง IT เต็มเวลา เหมาะทุกขนาดองค์กร",
  },
  {
    q: "ถ้าระบบ Server หรือ Network ล่ม ทีม BizGrow Tech แก้ไขได้เร็วแค่ไหน?",
    a: "BizGrow Tech การันตี SLA Response ผ่าน Remote ภายใน 1 ชม. สำหรับ On-site ในพื้นที่ ไทรน้อย บางบัวทอง บางใหญ่ บางกรวย (นนทบุรี) รับประกันภายใน 4–6 ชั่วโมง",
  },
  {
    q: "นอกจากดูแลระบบคอมพิวเตอร์แล้วดูแลอะไรได้อีกบ้าง?",
    a: "นอกจากดูแลระบบคอมพิวเตอร์แบบครบวงจรแล้ว BizGrow Tech ยังมีบริการรับทำ SEO, AEO (Answer Engine Optimization) และ GEO แบบรายเดือน รวมถึงรับออกแบบและดูแลเว็บไซต์องค์กร เว็บขายของออนไลน์ (E-commerce) ให้พร้อมใช้งานและติดอันดับบนหน้าค้นหาของ Google อย่างมีประสิทธิภาพ",
  },
  {
    q: "มีบริการนอกเวลาทำการหรือวันหยุดไหม?",
    a: "นอกเวลาทำการ สำหรับ Remote Support รับแจ้งปัญหาได้ตลอด 24 ชั่วโมงผ่าน Line Official โดยทีมงานจะดำเนินการแก้ไขตามลำดับความเร่งด่วน",
  },
  {
    q: "ดูแลระบบ Cloud เช่น Microsoft 365 หรือ Google Workspace ได้ไหม?",
    a: "ทีมงาน BizGrow Tech มีความเชี่ยวชาญในการดูแลระบบ Cloud ครบวงจร ทั้ง Microsoft 365, Microsoft Azure และ Google Workspace บริการครอบคลุมตั้งแต่การตั้งค่าความปลอดภัย (Security Policy), การจัดการบัญชีผู้ใช้และ License, การสำรองข้อมูล (Backup) และการย้ายข้อมูล (Migration) ระหว่าง Platform อย่างปลอดภัยและไม่มีข้อมูลสูญหาย",
  },
  {
    q: "ต้องทำสัญญาระยะยาวไหม? ยกเลิกได้ไหม?",
    a: "มีทั้งแบบรายเดือน (Month-to-Month) และแบบสัญญารายปี (ราคาพิเศษกว่า) สำหรับสัญญารายปีมีข้อดีเรื่อง On-site Visit เพิ่ม สามารถยกเลิกได้ตามข้อตกลงในสัญญา โดยไม่มีค่าปรับซ่อนเร้น",
  },
  {
    q: "บริการ On-site ครอบคลุมพื้นที่ไหนบ้าง?",
    a: "บริการ On-site หลักครอบคลุมพื้นที่นนทบุรี ได้แก่ ไทรน้อย บางบัวทอง บางใหญ่ บางกรวย รวมถึงกรุงเทพฯ และปริมณฑล สำหรับพื้นที่ต่างจังหวัด สามารถนัดหมายล่วงหน้าหรือใช้บริการ Remote Support ได้",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<section class="faq section" id="faq" aria-label="Frequently Asked Questions">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="container">
    <div class="faq__header">
      <p class="section-label">FAQ</p>
      <h2 class="section-title">คำถามที่พบบ่อย</h2>
      <p class="section-subtitle">คำตอบตรงประเด็น ไม่ต้องเดา ไม่ต้องรอ</p>
    </div>

    <ul class="faq__list">
      {faqs.map((item, i) => (
        <li class="faq__item">
          <details class="faq__details" name="faq-group">
            <summary class="faq__question">
              <span>{item.q}</span>
              <span class="faq__chevron" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M6 9l6 6 6-6"/>
                </svg>
              </span>
            </summary>
            <div class="faq__answer">
              <p>{item.a}</p>
            </div>
          </details>
        </li>
      ))}
    </ul>

    <div class="faq__cta">
      <p>ยังมีคำถามอีกไหม?</p>
      <a href="#contact" class="btn btn-primary">ติดต่อทีมงานเราโดยตรง</a>
    </div>
  </div>
</section>

<style>
  .faq__header { max-width: 640px; margin-bottom: 3rem; }

  .faq__list {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 3rem;
    list-style: none;
    padding: 0;
  }

  .faq__item {
    background: var(--color-dark-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.2s;
  }

  .faq__item:has(.faq__details[open]) {
    border-color: rgba(107,190,40,0.5);
  }

  .faq__details { width: 100%; }

  .faq__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    list-style: none;
    user-select: none;
    transition: color 0.2s;
  }

  .faq__question::-webkit-details-marker { display: none; }
  .faq__question::marker { display: none; }

  .faq__question:hover { color: var(--color-orange); }

  .faq__chevron {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: transform 0.25s ease, color 0.2s;
  }

  .faq__details[open] .faq__chevron {
    transform: rotate(180deg);
    color: var(--color-orange);
  }

  .faq__answer {
    padding: 0 1.5rem 1.5rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }

  .faq__cta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .faq__cta p {
    font-size: 1rem;
    color: var(--color-text-muted);
  }
</style>


