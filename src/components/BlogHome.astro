---
// src/components/BlogHome.astro
let posts = [];
try {
  const res = await fetch(`https://www.bizgrowtech.com/wp-json/wp/v2/posts?categories=60&per_page=3&_embed&_t=${Date.now()}`);
  if (res.ok) {
    posts = await res.json();
  }
} catch (e) {
  console.error("Error fetching WP posts", e);
}
---

<section id="blog" class="section blog">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">บทความล่าสุด</h2>
      <p class="section-desc">ความรู้และสาระดีๆ เกี่ยวกับการดูแลระบบคอมพิวเตอร์และ IT Support</p>
    </div>

    <div class="blog-grid">
      {posts.length > 0 ? posts.map((post: any) => (
        <a href={`/blog/${decodeURIComponent(post.slug)}`} class="blog-card">
          <div class="blog-image">
            {post._embedded && post._embedded['wp:featuredmedia'] ? (
              <img 
                src={post._embedded['wp:featuredmedia'][0].source_url} 
                alt={post.title.rendered} 
                loading="lazy" 
                decoding="async"
                width="600"
                height="338" 
              />
            ) : (
              <div class="blog-image-placeholder">No Image</div>
            )}
          </div>
          <div class="blog-content">
            <h3 class="blog-title" set:html={post.title.rendered} />
            <div class="blog-excerpt" set:html={post.excerpt.rendered} />
            <span class="blog-readmore">อ่านเพิ่มเติม &rarr;</span>
          </div>
        </a>
      )) : (
        <p class="text-center" style="grid-column: 1 / -1; color: var(--color-text-muted);">ยังไม่มีบทความในขณะนี้</p>
      )}
    </div>

    {posts.length > 0 && (
      <div class="text-center" style="margin-top: 2.5rem;">
        <a href="/blog" class="btn btn-outline">ดูบทความทั้งหมด</a>
      </div>
    )}
  </div>
</section>

<style>
  .blog {
    background: var(--color-bg);
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 2.5rem;
  }
  .blog-card {
    background: var(--color-dark-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }
  .blog-card:hover {
    transform: translateY(-5px);
    border-color: rgba(107, 190, 40, 0.5);
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  }
  .blog-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: rgba(255,255,255,0.05);
    overflow: hidden;
  }
  .blog-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .blog-card:hover .blog-image img {
    transform: scale(1.05);
  }
  .blog-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
  }
  .blog-content {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .blog-title {
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-excerpt {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-excerpt :global(p) {
    margin: 0;
  }
  .blog-readmore {
    margin-top: auto;
    font-size: 0.875rem;
    color: var(--color-green-light);
    font-weight: 600;
  }
  .text-center { text-align: center; }
</style>
