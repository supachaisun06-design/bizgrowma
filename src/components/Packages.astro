---
// Service Packages - 4 tiers, no pricing, GEO/SEO comparison table
const packages = [
  {
    name: "Starter",
    tagline: "ธุรกิจขนาดเล็กมาก",
    devices: "1 – 5 เครื่อง",
    color: "#6BBE28",
    highlight: false,
    features: {
      devices:   "1 – 5 เครื่อง",
      remote:    "ไม่จำกัดจำนวนครั้ง",
      onsite:    "1 ครั้ง/เดือน (ฉุกเฉิน ภายใน 4 ชม.)",
      pm:        "ทุก 3 เดือน",
      server:    "เช็กการทำงานทั่วไป",
      backup:    "แอนตี้ไวรัส + Backup 1 จุด",
      report:    "สรุปประวัติแจ้งซ่อม",
    },
  },
  {
    name: "Basic",
    tagline: "ธุรกิจขนาดเล็ก",
    devices: "5 – 15 เครื่อง",
    color: "#4E9219",
    highlight: false,
    features: {
      devices:   "5 – 15 เครื่อง",
      remote:    "ไม่จำกัดจำนวนครั้ง",
      onsite:    "1 ครั้ง/เดือน (ฉุกเฉิน ภายใน 4 ชม.)",
      pm:        "ทุก 3 เดือน",
      server:    "เช็กการทำงานทั่วไป",
      backup:    "แอนตี้ไวรัส + Backup 1 จุด",
      report:    "สรุปประวัติแจ้งซ่อม",
    },
  },
  {
    name: "Pro",
    tagline: "ธุรกิจขนาดกลาง",
    devices: "15 – 25 เครื่อง",
    color: "#F5921C",
    highlight: true,
    features: {
      devices:   "15 – 25 เครื่อง",
      remote:    "ไม่จำกัดจำนวนครั้ง",
      onsite:    "2 ครั้ง/เดือน (ฉุกเฉิน ภายใน 2–3 ชม.)",
      pm:        "ทุกเดือน",
      server:    "ดูแลเชิงลึก + อัปเดต OS/Patch",
      backup:    "สำรองข้อมูล Cloud/NAS + Cloudflare",
      report:    "สรุปปัญหา + วิเคราะห์ระบบ",
    },
  },
];

const rows = [
  { key: "devices", label: "จำนวนอุปกรณ์ที่ดูแล",           icon: "🖥️" },
  { key: "remote",  label: "Remote Support (ออนไลน์)",       icon: "🌐" },
  { key: "onsite",  label: "On-site Service (เข้าหน้างาน)", icon: "🔧" },
  { key: "pm",      label: "ตรวจเช็ก-บำรุงรักษา (PM)",      icon: "📋" },
  { key: "server",  label: "ดูแล Server & Cloud",             icon: "🗄️" },
  { key: "backup",  label: "Backup & Security",               icon: "🔒" },
  { key: "report",  label: "รายงานสรุปประจำเดือน",          icon: "📊" },
];

const addons = [
  { label: "เครื่องคอมพิวเตอร์ส่วนเกินนอกโควตา",   price: "300 – 350 บาท / เครื่อง / เดือน" },
  { label: "ดูแล Server เพิ่มเติม",                  price: "1,000 – 2,000 บาท / เครื่อง / เดือน" },
  { label: "ดูแล NAS หรือ Firewall เพิ่มเติม",       price: "500 – 1,000 บาท / เครื่อง / เดือน" },
  { label: "เรียกเข้าหน้างานฉุกเฉินนอกโควตา",       price: "1,500 – 2,500 บาท / ครั้ง" },
];
---

<section class="packages section" id="packages" aria-label="Service Packages">
  <div class="container">

    <div class="packages__header">
      <p class="section-label">แพ็กเกจบริการ</p>
      <h2 class="section-title">ตารางราคาและแพ็กเกจบริการ<br />IT Support รายเดือน</h2>
      <p class="section-subtitle">
        4 ระดับบริการ ครอบคลุมทุกขนาดธุรกิจ — ติดต่อเพื่อรับใบเสนอราคาที่ตรงกับความต้องการของคุณ
      </p>
      <div class="packages__note">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
        </svg>
        ราคาข้างต้นเป็นราคาสำหรับสัญญารายปี และยังไม่รวม VAT 7% — <a href="#contact">ติดต่อเพื่อรับใบเสนอราคา</a>
      </div>
    </div>

    <!-- ===== DESKTOP: Comparison Table (GEO-friendly) ===== -->
    <div class="pkg-table-wrap" role="region" aria-label="ตารางเปรียบเทียบแพ็กเกจ">
      <table class="pkg-table">
        <caption class="sr-only">
          ตารางเปรียบเทียบแพ็กเกจ IT Support Outsource รายเดือน ของ BizGrow Tech
        </caption>
        <thead>
          <tr>
            <th scope="col" class="pkg-table__label-col">รายการบริการ</th>
            {packages.map((pkg) => (
              <th
                scope="col"
                class={`pkg-table__head ${pkg.highlight ? "is-featured" : ""}`}
                style={`--pkg-color: ${pkg.color}`}
              >
                {pkg.highlight && <span class="pkg-table__badge">⭐ แนะนำ</span>}
                <span class="pkg-head-name">{pkg.name}</span>
                <span class="pkg-head-tag">{pkg.tagline}</span>
                <span class="pkg-head-devices">{pkg.devices}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row, i) => (
            <tr class={i % 2 === 0 ? "tr-alt" : ""}>
              <td class="pkg-table__row-label">
                <span class="row-icon" aria-hidden="true">{row.icon}</span>
                {row.label}
              </td>
              {packages.map((pkg) => (
                <td class={pkg.highlight ? "is-featured" : ""} style={`--pkg-color: ${pkg.color}`}>
                  {pkg.features[row.key as keyof typeof pkg.features]}
                </td>
              ))}
            </tr>
          ))}
          <tr class="tr-cta">
            <td class="pkg-table__row-label">ราคา</td>
            {packages.map((pkg) => (
              <td class={pkg.highlight ? "is-featured" : ""}>
                <a
                  href="#contact"
                  class={`btn pkg-table__btn ${pkg.highlight ? "" : "btn-outline-pkg"}`}
                  style={pkg.highlight ? `background: ${pkg.color}; color:#fff; box-shadow: 0 4px 18px ${pkg.color}55;` : `border-color: ${pkg.color}40; color: ${pkg.color};`}
                >
                  ขอใบเสนอราคา
                </a>
              </td>
            ))}
          </tr>
        </tbody>
      </table>
    </div>

    <!-- ===== MOBILE: Cards ===== -->
    <div class="pkg-cards" aria-label="Package cards">
      {packages.map((pkg) => (
        <article
          class={`pkg-card ${pkg.highlight ? "pkg-card--featured" : ""}`}
          style={`--pkg-color: ${pkg.color}`}
        >
          {pkg.highlight && <div class="pkg-card__badge">⭐ แนะนำ</div>}
          <div class="pkg-card__header">
            <div class="pkg-card__name-row">
              <span class="pkg-card__name">{pkg.name}</span>
              <span class="pkg-card__tag">{pkg.tagline}</span>
            </div>
            <div class="pkg-card__devices">{pkg.devices}</div>
          </div>
          <ul class="pkg-card__list">
            {rows.map((row) => (
              <li class="pkg-card__item">
                <span class="pkg-card__item-icon" aria-hidden="true">{row.icon}</span>
                <div>
                  <span class="pkg-card__item-label">{row.label}</span>
                  <span class="pkg-card__item-val">
                    {pkg.features[row.key as keyof typeof pkg.features]}
                  </span>
                </div>
              </li>
            ))}
          </ul>
          <a
            href="#contact"
            class="btn"
            style={`background: ${pkg.color}; color:#fff; width:100%; justify-content:center;`}
          >
            ขอใบเสนอราคา
          </a>
        </article>
      ))}
    </div>

    <!-- ===== Add-ons ===== -->
    <div class="pkg-addons">
      <div class="pkg-addons__header">
        <span class="pkg-addons__icon" aria-hidden="true">➕</span>
        <div>
          <h3 class="pkg-addons__title">บริการเสริม (Add-ons)</h3>
          <p class="pkg-addons__desc">สามารถเพิ่มบริการเสริมนอกเหนือจากแพ็กเกจหลักได้ตามต้องการ</p>
        </div>
      </div>
      <div class="pkg-addons__grid">
        {addons.map((addon) => (
          <div class="pkg-addon-item">
            <span class="pkg-addon-dot" aria-hidden="true"></span>
            <div class="pkg-addon-content">
              <span class="pkg-addon-label">{addon.label}</span>
              <span class="pkg-addon-price">{addon.price}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .sr-only {
    position: absolute; width:1px; height:1px;
    padding:0; margin:-1px; overflow:hidden;
    clip:rect(0,0,0,0); white-space:nowrap; border:0;
  }

  /* Header */
  .packages__header { max-width: 700px; margin-bottom: 2.5rem; }

  .packages__note {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(245,146,28,0.08);
    border: 1px solid rgba(245,146,28,0.2);
    border-radius: 8px;
    padding: 0.55rem 1rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 1rem;
  }
  .packages__note a { color: var(--color-orange-light); text-decoration: underline; }
  .packages__note svg { color: var(--color-orange); flex-shrink: 0; }

  /* ===== TABLE ===== */
  .pkg-table-wrap {
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    overflow-x: auto;
    margin-bottom: 2rem;
  }

  .pkg-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  /* Head */
  .pkg-table thead tr { background: var(--color-dark-3); }

  .pkg-table__head {
    padding: 1.25rem 1.25rem 1.5rem;
    text-align: center;
    border-bottom: 3px solid var(--pkg-color);
    position: relative;
    vertical-align: top;
    min-width: 160px;
  }

  .pkg-table__head.is-featured {
    background: rgba(245,146,28,0.06);
  }

  .pkg-table__badge {
    display: inline-block;
    background: var(--pkg-color);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.7rem;
    border-radius: 50px;
    margin-bottom: 0.5rem;
  }

  .pkg-head-name {
    display: block;
    font-family: var(--font-en);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--pkg-color);
  }
  .pkg-head-tag {
    display: block;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-top: 0.2rem;
  }
  .pkg-head-devices {
    display: inline-block;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 50px;
    padding: 0.2rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text);
    margin-top: 0.5rem;
  }

  /* Label col */
  .pkg-table__label-col {
    padding: 1.25rem 1.25rem 1.5rem;
    text-align: left;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-muted);
    min-width: 180px;
    background: var(--color-dark-3);
    border-bottom: 3px solid var(--color-border);
  }

  /* Body rows */
  .pkg-table tbody td {
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    color: var(--color-text-muted);
    font-size: 0.875rem;
    text-align: center;
    vertical-align: middle;
    line-height: 1.5;
  }

  .pkg-table__row-label {
    text-align: left !important;
    font-weight: 600;
    color: var(--color-text) !important;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .row-icon { font-size: 1rem; flex-shrink: 0; }

  .tr-alt td { background: rgba(255,255,255,0.015); }
  .is-featured { background: rgba(245,146,28,0.04) !important; }

  /* CTA row */
  .tr-cta td {
    border-bottom: none;
    padding: 1.25rem;
    text-align: center;
  }

  .pkg-table__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 1.25rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s;
    white-space: nowrap;
    border: 1.5px solid transparent;
  }
  .btn-outline-pkg {
    background: transparent;
    border: 1.5px solid;
  }
  .btn-outline-pkg:hover { opacity: 0.8; transform: translateY(-1px); }
  .pkg-table__btn:not(.btn-outline-pkg):hover { filter: brightness(1.1); transform: translateY(-1px); }

  /* ===== CARDS (mobile) ===== */
  .pkg-cards {
    display: none;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .pkg-card {
    background: var(--color-dark-card);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--pkg-color);
    border-radius: var(--radius);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: relative;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .pkg-card--featured {
    border-color: var(--pkg-color);
    box-shadow: 0 8px 40px rgba(245,146,28,0.18);
    transform: translateY(-4px);
  }

  .pkg-card__badge {
    position: absolute;
    top: -14px; left: 50%;
    transform: translateX(-50%);
    background: var(--pkg-color);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 1rem;
    border-radius: 50px;
    white-space: nowrap;
  }

  .pkg-card__header { border-bottom: 1px solid var(--color-border); padding-bottom: 1rem; }

  .pkg-card__name-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }
  .pkg-card__name {
    font-family: var(--font-en);
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--pkg-color);
  }
  .pkg-card__tag { font-size: 0.8rem; color: var(--color-text-muted); }

  .pkg-card__devices {
    display: inline-block;
    background: rgba(255,255,255,0.05);
    border-radius: 50px;
    padding: 0.2rem 0.8rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .pkg-card__list { list-style: none; display: flex; flex-direction: column; gap: 0.75rem; }

  .pkg-card__item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.875rem;
  }
  .pkg-card__item-icon { font-size: 1rem; flex-shrink: 0; margin-top: 0.1rem; }
  .pkg-card__item-label {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .pkg-card__item-val { display: block; color: var(--color-text-muted); line-height: 1.5; }

  /* ===== ADD-ONS ===== */
  .pkg-addons {
    background: var(--color-dark-card);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-orange);
    border-radius: var(--radius);
    padding: 2rem;
    margin-top: 1rem;
  }

  .pkg-addons__header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .pkg-addons__icon {
    font-size: 1.5rem;
    width: 44px; height: 44px;
    background: rgba(245,146,28,0.1);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }

  .pkg-addons__title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }
  .pkg-addons__desc { font-size: 0.875rem; color: var(--color-text-muted); }

  .pkg-addons__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0.75rem;
  }

  .pkg-addon-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: rgba(255,255,255,0.025);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 10px;
  }

  .pkg-addon-dot {
    width: 8px; height: 8px;
    background: var(--color-orange);
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 0.35rem;
  }

  .pkg-addon-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.2rem;
  }
  .pkg-addon-price {
    display: block;
    font-family: var(--font-en);
    font-size: 0.82rem;
    color: var(--color-orange-light);
    font-weight: 600;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .pkg-table-wrap { display: none; }
    .pkg-cards { display: grid; }
  }
</style>
