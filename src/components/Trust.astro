---
// Trust Signals Section - GEO/SEO E-E-A-T
const certifications = [
  { name: "CompTIA A+", org: "CompTIA", color: "#E31837" },
  { name: "CompTIA Network+", org: "CompTIA", color: "#E31837" },
  { name: "Cisco CCNA", org: "Cisco", color: "#049FD9" },
  { name: "Microsoft Certified", org: "Microsoft", color: "#00A4EF" },
  { name: "VMware VCP", org: "VMware", color: "#607078" },
];

const testimonials = [
  {
    quote: "หลังจากใช้บริการ BizGrow Tech ปัญหาระบบล่มที่เกิดขึ้นเกือบทุกสัปดาห์หายไปเลย ทีมงานตอบสนองเร็ว แก้ปัญหาได้จริง",
    author: "คุณสมชาย วิทยาการ",
    role: "ผู้จัดการฝ่าย Operations",
    company: "บริษัท ABC Trading จำกัด",
    rating: 5,
  },
  {
    quote: "ประหยัดค่าใช้จ่ายด้าน IT ไปได้กว่า 40% เมื่อเทียบกับการจ้างพนักงานประจำ แถมได้ผู้เชี่ยวชาญหลายคนดูแลแทนคนเดียว",
    author: "คุณนงนุช ศรีสวัสดิ์",
    role: "Director",
    company: "XYZ Clinic Group",
    rating: 5,
  },
  {
    quote: "Data ของเราเคยโดน Ransomware ครั้งหนึ่ง หลังจากให้ BizGrow Tech ดูแล ระบบ Backup และ Security แน่นมาก",
    author: "คุณประเสริฐ มานะดี",
    role: "CEO",
    company: "StartUp Thailand Co., Ltd.",
    rating: 5,
  },
];

const clientLogos = [
  "ABC Trading", "XYZ Clinic", "MedHub", "RetailPlus", "TechStart", "EduPro"
];
---

<section class="trust section" id="trust" aria-label="Trust Signals and Credentials">
  <div class="container">
    <!-- Client Logos -->
    <div class="trust__clients">
      <p class="trust__clients-label">ไว้วางใจโดยองค์กรชั้นนำกว่า 200 แห่ง</p>
      <div class="trust__logos" role="list" aria-label="Client logos">
        {clientLogos.map((name) => (
          <div class="trust__logo" role="listitem" aria-label={name}>
            <span class="trust__logo-text">{name}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="trust__grid">
      <!-- Certifications -->
      <div class="trust__certs">
        <p class="section-label">ใบรับรองมาตรฐาน</p>
        <h2 class="trust__cert-title">ทีมงานที่ผ่านการรับรองระดับสากล</h2>
        <p class="trust__cert-desc">
          ผู้เชี่ยวชาญของเรามีใบรับรองมาตรฐานสากล รับประกันความสามารถและความเชี่ยวชาญในระดับสูงสุด
        </p>
        <div class="trust__cert-list" role="list">
          {certifications.map((cert) => (
            <div class="trust__cert-item" role="listitem" style={`--cert-color: ${cert.color}`}>
              <div class="trust__cert-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
                  <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
              </div>
              <div>
                <strong class="trust__cert-name">{cert.name}</strong>
                <span class="trust__cert-org">{cert.org} Certified</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Testimonials -->
      <div class="trust__testimonials">
        <p class="section-label">รีวิวจากลูกค้าจริง</p>
        <h2 class="trust__test-title">สิ่งที่ลูกค้าพูดถึงเรา</h2>
        <div class="trust__test-list" role="list">
          {testimonials.map((t) => (
            <blockquote class="trust__test-card" role="listitem" itemscope itemtype="https://schema.org/Review">
              <div class="trust__test-stars" aria-label={`${t.rating} ดาวจาก 5 ดาว`} role="img">
                {"★".repeat(t.rating)}
              </div>
              <p class="trust__test-quote" itemprop="reviewBody">"{t.quote}"</p>
              <footer class="trust__test-author" itemprop="author" itemscope itemtype="https://schema.org/Person">
                <div class="trust__test-avatar" aria-hidden="true">
                  {t.author.split(" ").map(w => w[0]).join("").slice(0,2)}
                </div>
                <div>
                  <cite class="trust__test-name" itemprop="name">{t.author}</cite>
                  <span class="trust__test-meta">{t.role} · {t.company}</span>
                </div>
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .trust__clients {
    text-align: center;
    margin-bottom: 5rem;
  }

  .trust__clients-label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    letter-spacing: 0.05em;
  }

  .trust__logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .trust__logo {
    background: var(--color-dark-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.75rem 2rem;
    transition: border-color 0.2s;
  }
  .trust__logo:hover { border-color:  "rgba(107,190,40,0.$($args[0].Groups[1].Value))" ; }

  .trust__logo-text {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .trust__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* Certifications */
  .trust__cert-title, .trust__test-title {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .trust__cert-desc { font-size: 0.95rem; color: var(--color-text-muted); margin-bottom: 1.5rem; }

  .trust__cert-list { display: flex; flex-direction: column; gap: 0.75rem; }

  .trust__cert-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--color-dark-card);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--cert-color);
    border-radius: var(--radius);
    padding: 0.85rem 1.25rem;
  }

  .trust__cert-icon {
    width: 36px;
    height: 36px;
    background: rgba(255,255,255,0.05);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cert-color);
    flex-shrink: 0;
  }

  .trust__cert-name {
    display: block;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .trust__cert-org { font-size: 0.8rem; color: var(--color-text-muted); }

  /* Testimonials */
  .trust__test-list { display: flex; flex-direction: column; gap: 1rem; margin-top: 1.5rem; }

  .trust__test-card {
    background: var(--color-dark-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition: border-color 0.2s;
  }
  .trust__test-card:hover { border-color:  "rgba(107,190,40,0.$($args[0].Groups[1].Value))" ; }

  .trust__test-stars {
    color: #FBC02D;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .trust__test-quote {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: 1.25rem;
    font-style: normal;
  }

  .trust__test-author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-style: normal;
  }

  .trust__test-avatar {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, var(--color-green), var(--color-orange));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 800;
    color: #fff;
    flex-shrink: 0;
  }

  .trust__test-name {
    display: block;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text);
    font-style: normal;
  }
  .trust__test-meta { font-size: 0.8rem; color: var(--color-text-muted); }

  @media (max-width: 900px) {
    .trust__grid { grid-template-columns: 1fr; gap: 3rem; }
  }
</style>


