---
// Team In Action Section - shows real team working
---

<section class="team-action section" id="team" aria-label="Our Team in Action">
  <div class="container">
    <div class="team-action__wrapper">

      <!-- Image side -->
      <div class="team-action__visual">
        <div class="team-action__img-wrap">
          <img
            src="/team-monitoring.jpg"
            alt="ทีม BizGrow Tech กำลัง Monitor ระบบและ Network ของลูกค้า"
            class="team-action__img"
            width="640"
            height="426"
            loading="lazy"
          />
          <!-- Floating stats -->
          <div class="team-action__stat-card team-action__stat-card--top">
            <div class="tac-stat-row">
              <span class="tac-dot"></span>
              <span class="tac-label">Monitoring Active</span>
            </div>
            <div class="tac-num">247 Devices</div>
          </div>
          <div class="team-action__stat-card team-action__stat-card--bottom">
            <div class="tac-label">Incidents Resolved Today</div>
            <div class="tac-num tac-num--orange">12 / 12 ✓</div>
          </div>
        </div>
      </div>

      <!-- Content side -->
      <div class="team-action__content">
        <p class="section-label">ทีมผู้เชี่ยวชาญ</p>
        <h2 class="section-title">
          ทีมไอที <span class="team-action__highlight">มืออาชีพ</span><br />
          พร้อมทุกเวลา
        </h2>
        <p class="section-subtitle">
          ทีมงานของเรามีประสบการณ์ดูแลระบบมากกว่า 10 ปี พร้อมใบรับรองมาตรฐานสากล
          และใช้เครื่องมือ Monitoring ระดับ Enterprise ตรวจสอบระบบของคุณตลอด 24 ชั่วโมง
        </p>

        <ul class="team-action__features">
          <li class="taf-item">
            <div class="taf-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
              </svg>
            </div>
            <div>
              <strong>24/7 Remote Monitoring</strong>
              <p>ระบบแจ้งเตือนอัตโนมัติ ตรวจพบปัญหาก่อนที่คุณจะรู้สึก</p>
            </div>
          </li>
          <li class="taf-item">
            <div class="taf-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
              </svg>
            </div>
            <div>
              <strong>ทีมผู้เชี่ยวชาญเฉพาะทาง</strong>
              <p>Network Engineer, Security Specialist, System Admin ในทีมเดียว</p>
            </div>
          </li>
          <li class="taf-item">
            <div class="taf-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <rect x="2" y="3" width="20" height="14" rx="2"/>
                <path d="M8 21h8M12 17v4"/>
              </svg>
            </div>
            <div>
              <strong>On-site รวดเร็วทันใจ</strong>
              <p>ทีมเข้าพื้นที่บริการฉับไว เฉพาะในโซน ไทรน้อย บางบัวทอง บางใหญ่ บางกรวย ภายใน 2-4 ชั่วโมง</p>
            </div>
          </li>
          <li class="taf-item">
            <div class="taf-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M9 12l2 2 4-4M12 3a9 9 0 100 18 9 9 0 000-18z"/>
              </svg>
            </div>
            <div>
              <strong>SLA รับประกัน</strong>
              <p>ตอบสนองปัญหา Remote ภายใน 15 นาที พร้อมรายงานทุกเดือน</p>
            </div>
          </li>
        </ul>

        <a href="#contact" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.18 2 2 0 012 .01h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92z"/>
          </svg>
          คุยกับทีมของเรา
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .team-action__wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  /* === Visual === */
  .team-action__visual { position: relative; }

  .team-action__img-wrap {
    position: relative;
    border-radius: 20px;
    overflow: visible;
  }

  .team-action__img {
    width: 100%;
    height: auto;
    border-radius: 20px;
    object-fit: cover;
    box-shadow: 0 0 0 1px rgba(107,190,40,0.15), 0 20px 60px rgba(0,0,0,0.6);
    display: block;
  }

  /* Glow under image */
  .team-action__img-wrap::before {
    content: "";
    position: absolute;
    bottom: -20px;
    left: 10%;
    right: 10%;
    height: 60px;
    background: rgba(107,190,40,0.15);
    filter: blur(30px);
    border-radius: 50%;
    z-index: -1;
  }

  /* Floating stat cards */
  .team-action__stat-card {
    position: absolute;
    background: rgba(10, 14, 9, 0.9);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(107,190,40,0.2);
    border-radius: 12px;
    padding: 0.75rem 1.1rem;
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
    z-index: 10;
    animation: floatY 4s ease-in-out infinite;
  }

  .team-action__stat-card--top {
    top: 1.25rem;
    left: -1.5rem;
  }

  .team-action__stat-card--bottom {
    bottom: 1.5rem;
    right: -1.5rem;
    animation-delay: 2s;
  }

  @keyframes floatY {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .tac-stat-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.2rem;
  }

  .tac-dot {
    width: 8px; height: 8px;
    background: var(--color-green);
    border-radius: 50%;
    animation: pulse-green 2s infinite;
  }

  .tac-label {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .tac-num {
    font-family: var(--font-en);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-text);
  }

  .tac-num--orange { color: var(--color-green-light); }

  /* === Content === */
  .team-action__content { display: flex; flex-direction: column; gap: 1.5rem; }

  .team-action__highlight {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .team-action__features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .taf-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .taf-icon {
    width: 38px; height: 38px;
    background: rgba(107,190,40,0.1);
    border: 1px solid rgba(107,190,40,0.2);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    color: var(--color-green-light);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .taf-item strong {
    display: block;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.2rem;
  }

  .taf-item p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .team-action__wrapper { grid-template-columns: 1fr; }
    .team-action__stat-card--top { left: 0; }
    .team-action__stat-card--bottom { right: 0; }
  }

  @media (max-width: 600px) {
    .team-action__stat-card { display: none; }
  }
</style>
