---
// Services Section - 5 main service categories (based on gentechit.co.th structure)
const services = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
    color: "#6BBE28",
    title: "ดูแลอุปกรณ์ปลายทาง (Endpoint Management)",
    items: [
      "อัปเดต OS, Driver และ Software อย่างสม่ำเสมอ",
      "ติดตั้งระบบ Antivirus / Endpoint Security",
      "ทำความสะอาด ตรวจสอบประสิทธิภาพ และแก้ปัญหาช้า",
      "สำรองข้อมูล (Backup) และทดสอบการกู้คืน (Restore Test)",
      "รองรับทั้ง Windows และ macOS",
    ],
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>`,
    color: "#4E9219",
    title: "บริหารจัดการ Server (Server Management)",
    items: [
      "Monitor สถานะ CPU, RAM, Disk, Temperature แบบ Real-time",
      "ดูแล Windows Server, Active Directory, DNS, DHCP, File Server",
      "จัดการ VM Environment (VMware, Hyper-V, Proxmox)",
      "วางแผนและดำเนิน Patch Management อย่างปลอดภัย",
      "ตั้งค่า Backup ไปยัง Synology NAS และ Cloud",
    ],
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/></svg>`,
    color: "#F5921C",
    title: "บริหารเครือข่าย (Network Management)",
    items: [
      "Monitor Bandwidth, Latency และ Packet Loss ตลอด 24/7",
      "ดูแล Firewall (Fortinet FortiGate, pfSense, Sophos)",
      "จัดการ Switch, Router, Access Point (Cisco, MikroTik, Ubiquiti)",
      "ตั้งค่า VLAN, VPN Site-to-Site, SSL VPN",
      "ตรวจสอบช่องโหว่ Security Audit ทุกเดือน",
    ],
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.18 2 2 0 012 .01h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92z"/></svg>`,
