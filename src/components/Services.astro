---

<section class="services section" id="services" aria-label="IT Services">
  <div class="container">
    <div class="services__header">
      <p class="section-label">ขอบเขตบริการ</p>
      <h2 class="section-title">บริการดูแลระบบ IT ครบวงจร<br />สำหรับองค์กรทุกขนาด</h2>
      <p class="section-subtitle">
        BizGrow Tech ให้บริการ IT Outsource แบบครอบคลุม ตั้งแต่อุปกรณ์ปลายทาง เซิร์ฟเวอร์ เครือข่าย
        จนถึงการวางกลยุทธ์ IT ระยะยาว — ทีมเดียว ดูแลครบ
      </p>
    </div>

    <div class="services__grid">
      {services.map((svc) => (
        <article class="services__card" style={`--svc-color: ${svc.color}`}>
          <div class="services__card-header">
            <div class="services__icon" aria-hidden="true" set:html={svc.icon} />
            <h3 class="services__card-title">{svc.title}</h3>
          </div>
          <ul class="services__list">
            {svc.items.map((item) => (
              <li class="services__list-item">
                <span class="services__check" aria-hidden="true">✓</span>
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="services__cta-row">
      <p class="services__cta-text">สนใจบริการใด? ปรึกษาทีมงานฟรี ไม่มีข้อผูกมัด</p>
      <a href="#contact" class="btn btn-primary">ขอคำปรึกษาฟรี</a>
    </div>
  </div>
</section>

<style>
  .services__header { max-width: 700px; margin-bottom: 3rem; }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  /* Last row: 2 cards centered */
  .services__card:nth-child(4) { grid-column: 1 / 2; }
  .services__card:nth-child(5) { grid-column: 2 / 3; }

  .services__card {
    background: var(--color-dark-card);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--svc-color);
    border-radius: var(--radius);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .services__card:hover {
    border-color: var(--svc-color);
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.3);
  }

  .services__card-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .services__icon {
    width: 52px; height: 52px;
    background: color-mix(in srgb, var(--svc-color) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--svc-color) 25%, transparent);
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    color: var(--svc-color);
    flex-shrink: 0;
  }

  .services__card-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.4;
  }

  .services__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .services__list-item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .services__check {
    color: var(--svc-color);
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 0.05rem;
    font-size: 0.85rem;
  }

  .services__cta-row {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 2rem;
    background: rgba(107,190,40,0.04);
    border: 1px solid rgba(107,190,40,0.15);
    border-radius: var(--radius);
    flex-wrap: wrap;
  }

  .services__cta-text {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text);
    flex: 1;
    min-width: 200px;
  }

  @media (max-width: 1024px) {
    .services__grid { grid-template-columns: repeat(2, 1fr); }
    .services__card:nth-child(4),
    .services__card:nth-child(5) { grid-column: auto; }
  }
  @media (max-width: 600px) {
    .services__grid { grid-template-columns: 1fr; }
    .services__cta-row { flex-direction: column; align-items: flex-start; }
  }
</style>
