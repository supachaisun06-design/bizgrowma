---
const navLinks = [
  { href: "/#why-outsource", label: "ทำไมต้อง Outsource" },
  { href: "/#packages", label: "แพ็กเกจ" },
  { href: "/#process", label: "ขั้นตอน" },
  { href: "/#faq", label: "FAQ" },
  { href: "/#trust", label: "รีวิว" },
  { href: "/blog", label: "บทความ" },
];
---

<header class="navbar" role="banner">
  <div class="container navbar__container">

    <!-- LOGO -->
    <a href="/" class="navbar__logo" aria-label="BizGrow Tech - กลับหน้าหลัก">
      <img
        src="/logo.jpg"
        alt="BizGrow Tech Logo"
        width="40"
        height="40"
        class="navbar__logo-img"
        loading="eager"
      />
      <span class="navbar__logo-text">
        <span class="logo-biz">BizGrow</span><span class="logo-tech">Tech</span>
      </span>
    </a>

    <nav class="navbar__nav" aria-label="Main navigation">
      <a href="/#why-outsource" class="navbar__link">ทำไมต้อง Outsource</a>
      
      <!-- Dropdown บริการ -->
      <div class="navbar__dropdown">
        <button class="navbar__link navbar__dropdown-btn" aria-expanded="false">
          บริการ
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="navbar__dropdown-content">
          <a href="/service/sainoi" class="navbar__dropdown-link">ดูแลระบบคอมพิวเตอร์ ไทรน้อย</a>
          <a href="/service/bangbuathong" class="navbar__dropdown-link">ดูแลระบบคอมพิวเตอร์ บางบัวทอง</a>
          <a href="/service/bangyai" class="navbar__dropdown-link">ดูแลระบบคอมพิวเตอร์ บางใหญ่</a>
          <a href="/service/bangkruai" class="navbar__dropdown-link">ดูแลระบบคอมพิวเตอร์ บางกรวย</a>
        </div>
      </div>

      <a href="/#packages" class="navbar__link">แพ็กเกจ</a>
      <a href="/#process" class="navbar__link">ขั้นตอน</a>
      <a href="/#faq" class="navbar__link">FAQ</a>
      <a href="/#trust" class="navbar__link">รีวิว</a>
      <a href="/blog" class="navbar__link">บทความ</a>
    </nav>

    <div class="navbar__actions">
      <a href="tel:0922824848" class="navbar__phone" aria-label="โทรศัพท์ 092-282-4848">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.18 2 2 0 012 .01h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92z"/>
        </svg>
        <span>โทรศัพท์ 092-282-4848</span>
      </a>
      <button id="shareBtn" class="btn btn-outline navbar__share" aria-label="แชร์เว็บไซต์">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
          <polyline points="16 6 12 2 8 6"></polyline>
          <line x1="12" y1="2" x2="12" y2="15"></line>
        </svg>
        <span>แชร์เว็บไซต์</span>
      </button>
      <a href="/#contact" class="btn btn-primary navbar__cta">ปรึกษาฟรี</a>
    </div>

    <button class="navbar__hamburger" id="hamburger" aria-label="เปิดเมนู" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div class="navbar__mobile" id="mobile-menu" aria-label="Mobile navigation">
    <a href="/#why-outsource" class="navbar__mobile-link">ทำไมต้อง Outsource</a>
    
    <!-- Mobile Dropdown บริการ -->
    <button class="navbar__mobile-link navbar__mobile-dropdown-btn" aria-expanded="false" style="width: 100%; display: flex; justify-content: space-between; align-items: center; border: none; background: none; font-family: inherit;">
      บริการ
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>
    <div class="navbar__mobile-dropdown-content" style="display: none; flex-direction: column; padding-left: 1rem; border-left: 2px solid rgba(107,190,40,0.2); margin-left: 0.5rem; gap: 0.5rem;">
      <a href="/service/sainoi" class="navbar__mobile-link" style="font-size: 0.95rem; padding: 0.5rem 0;">ดูแลระบบคอมพิวเตอร์ ไทรน้อย</a>
      <a href="/service/bangbuathong" class="navbar__mobile-link" style="font-size: 0.95rem; padding: 0.5rem 0;">ดูแลระบบคอมพิวเตอร์ บางบัวทอง</a>
      <a href="/service/bangyai" class="navbar__mobile-link" style="font-size: 0.95rem; padding: 0.5rem 0;">ดูแลระบบคอมพิวเตอร์ บางใหญ่</a>
      <a href="/service/bangkruai" class="navbar__mobile-link" style="font-size: 0.95rem; padding: 0.5rem 0;">ดูแลระบบคอมพิวเตอร์ บางกรวย</a>
    </div>

    <a href="/#packages" class="navbar__mobile-link">แพ็กเกจ</a>
    <a href="/#process" class="navbar__mobile-link">ขั้นตอน</a>
    <a href="/#faq" class="navbar__mobile-link">FAQ</a>
    <a href="/#trust" class="navbar__mobile-link">รีวิว</a>
    <a href="/blog" class="navbar__mobile-link">บทความ</a>
    <div style="display: flex; gap: 0.5rem; margin-top: 1rem; width: 100%;">
      <a href="tel:0922824848" class="btn btn-outline" style="flex: 1; justify-content: center; display: flex; align-items: center; gap: 0.5rem;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.18 2 2 0 012 .01h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92z"/>
        </svg>
        โทรเลย
      </a>
      <a href="/#contact" class="btn btn-primary" style="flex: 1; justify-content: center;">ปรึกษาฟรี</a>
    </div>
  </div>
</header>

<script>
  // Mobile Menu Logic
  const hamburger = document.getElementById("hamburger") as HTMLButtonElement | null;
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileLinks = document.querySelectorAll(".navbar__mobile-link");

  if (hamburger && mobileMenu) {
    hamburger.addEventListener("click", () => {
      const isExpanded = hamburger.getAttribute("aria-expanded") === "true";
      hamburger.setAttribute("aria-expanded", String(!isExpanded));
      hamburger.classList.toggle("is-active");
      mobileMenu.classList.toggle("is-open");
    });

    mobileLinks.forEach((link) => {
      // Don't close menu if clicking the dropdown button
      if (link.classList.contains("navbar__mobile-dropdown-btn")) return;
      link.addEventListener("click", () => {
        hamburger.setAttribute("aria-expanded", "false");
        hamburger.classList.remove("is-active");
        mobileMenu.classList.remove("is-open");
      });
    });

    const mobileDropdownBtn = document.querySelector(".navbar__mobile-dropdown-btn");
    const mobileDropdownContent = document.querySelector(".navbar__mobile-dropdown-content") as HTMLElement;
    if (mobileDropdownBtn && mobileDropdownContent) {
      mobileDropdownBtn.addEventListener("click", (e) => {
        e.preventDefault();
        const isExpanded = mobileDropdownBtn.getAttribute("aria-expanded") === "true";
        mobileDropdownBtn.setAttribute("aria-expanded", String(!isExpanded));
        mobileDropdownContent.style.display = isExpanded ? "none" : "flex";
      });
    }
  }

  // Navbar Scroll Effect
  const navbar = document.querySelector(".navbar");
  window.addEventListener("scroll", () => {
    if (window.scrollY > 20) {
      navbar?.classList.add("navbar--scrolled");
    } else {
      navbar?.classList.remove("navbar--scrolled");
    }
  });
  // Share Logic
  const shareData = {
    title: document.title,
    text: 'BizGrow Tech - บริการ IT Support ดูแลระบบคอมพิวเตอร์ครบวงจร',
    url: window.location.href
  };

  const handleShare = async () => {
    try {
      if (navigator.share) {
        await navigator.share(shareData);
      } else {
        await navigator.clipboard.writeText(shareData.url);
        alert('คัดลอกลิงก์เรียบร้อยแล้ว!');
      }
    } catch (err) {
      console.log('Error sharing:', err);
    }
  };

  document.getElementById('shareBtn')?.addEventListener('click', handleShare);
</script>

<style>
  .navbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    padding: 0.75rem 0;
    transition: background 0.3s, box-shadow 0.3s;
  }

  .navbar--scrolled {
    background: rgba(12, 14, 9, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 1px 0 rgba(107,190,40,0.12);
  }

  .navbar__container {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  /* --- Logo --- */
  .navbar__logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
    text-decoration: none;
  }

  .navbar__logo-img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 2px rgba(107,190,40,0.4);
    flex-shrink: 0;
    display: block;
  }

  .navbar__logo-text {
    font-family: var(--font-en);
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .logo-biz { color: var(--color-text); }
  .logo-tech { color: var(--color-green); }

  /* --- Nav links --- */
  .navbar__nav {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    flex: 1;
    justify-content: center;
  }

  .navbar__link {
    padding: 0.4rem 0.8rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
    white-space: nowrap;
    text-decoration: none;
  }
  .navbar__link:hover {
    color: var(--color-text);
    background: rgba(107,190,40,0.08);
  }

  /* Dropdown Styles */
  .navbar__dropdown {
    position: relative;
    display: inline-block;
  }
  .navbar__dropdown-btn {
    border: none;
    background: none;
    font-family: inherit;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }
  .navbar__dropdown-content {
    visibility: hidden;
    opacity: 0;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: rgba(12, 14, 9, 0.96);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(107,190,40,0.15);
    min-width: 260px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    border-radius: 12px;
    padding: 0.5rem;
    z-index: 1000;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .navbar__dropdown:hover .navbar__dropdown-content,
  .navbar__dropdown:focus-within .navbar__dropdown-content {
    visibility: visible;
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .navbar__dropdown-link {
    display: block;
    padding: 0.6rem 1rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.15s ease;
  }
  .navbar__dropdown-link:hover {
    color: var(--color-text);
    background: rgba(107,190,40,0.12);
  }


  /* --- Actions --- */
  .navbar__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .navbar__phone {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-text-muted);
    transition: color 0.15s;
    text-decoration: none;
  }
  .navbar__phone:hover { color: var(--color-green-light); }
  .navbar__share {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    padding: 0.45rem 0.8rem;
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .navbar__share:hover { background: rgba(255,255,255,0.05); border-color: var(--color-text-muted); }

  .navbar__cta { padding: 0.5rem 1.2rem; font-size: 0.875rem; }

  /* --- Hamburger --- */
  .navbar__hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.4rem;
    margin-left: auto;
    flex-shrink: 0;
  }

  .navbar__hamburger span {
    display: block;
    width: 22px; height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform 0.25s, opacity 0.25s;
    transform-origin: center;
  }

  .navbar__hamburger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .navbar__hamburger.is-open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .navbar__hamburger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* --- Mobile Menu (transition-based, no hidden attr) --- */
  .navbar__mobile {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    pointer-events: none;
    transition: max-height 0.35s ease, opacity 0.25s ease, padding 0.3s ease;
    background: rgba(12, 14, 9, 0.97);
    backdrop-filter: blur(16px);
    border-top: 1px solid rgba(107,190,40,0.12);
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0 1.5rem;
  }

  .navbar__mobile.is-open {
    max-height: 800px;
    opacity: 1;
    pointer-events: all;
    padding: 1rem 1.5rem 1.5rem;
    overflow-y: auto;
  }

  .navbar__mobile-link {
    padding: 0.8rem 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-muted);
    border-bottom: 1px solid rgba(107,190,40,0.08);
    transition: color 0.15s;
    text-decoration: none;
    display: block;
  }
  .navbar__mobile-link:hover { color: var(--color-green-light); }

  @media (max-width: 900px) {
    .navbar__nav,
    .navbar__phone,
    .navbar__cta { display: none; }
    .navbar__hamburger { display: flex; }
  }
</style>
