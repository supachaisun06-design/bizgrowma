---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

let posts = [];
try {
  const res = await fetch('https://www.bizgrowtech.com/wp-json/wp/v2/posts?categories=60&_embed&per_page=100');
  if (res.ok) {
    posts = await res.json();
  }
} catch (e) {
  console.error(e);
}
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "หน้าหลัก",
      "item": "https://it-outsource.bizgrowtech.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "บทความ"
    }
  ]
};
---

<Layout title="บทความความรู้ IT Support - BizGrow Tech" description="รวมบทความน่ารู้เกี่ยวกับการดูแลระบบคอมพิวเตอร์ IT Support และการแก้ไขปัญหาเบื้องต้น">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <Navbar />
  <main id="main-content" style="padding-top: 100px; padding-bottom: 80px; min-height: 80vh;">
    <div class="container">
      
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">หน้าหลัก</a></li>
          <li aria-current="page">บทความ</li>
        </ol>
      </nav>

      <div class="section-header" style="text-align: center; margin-bottom: 3rem;">
        <h1 class="section-title">บทความทั้งหมด</h1>
        <p class="section-desc">รวมความรู้และสาระดีๆ เกี่ยวกับการดูแลระบบคอมพิวเตอร์</p>
      </div>

      <div class="blog-grid">
        {posts.length > 0 ? posts.map((post: any) => (
          <a href={`/blog/${decodeURIComponent(post.slug)}`} class="blog-card">
            <div class="blog-image">
              {post._embedded && post._embedded['wp:featuredmedia'] ? (
                <img 
                  src={post._embedded['wp:featuredmedia'][0].source_url} 
                  alt={post.title.rendered} 
                  loading="lazy" 
                  decoding="async" 
                />
              ) : (
                <div class="blog-image-placeholder">No Image</div>
              )}
            </div>
            <div class="blog-content">
              <h2 class="blog-title" set:html={post.title.rendered} />
              <div class="blog-excerpt" set:html={post.excerpt.rendered} />
              <span class="blog-readmore">อ่านเพิ่มเติม &rarr;</span>
            </div>
          </a>
        )) : (
          <p class="text-center" style="grid-column: 1 / -1; color: var(--color-text-muted);">ยังไม่มีบทความในขณะนี้</p>
        )}
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .breadcrumb {
    margin-bottom: 2rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .breadcrumb li {
    display: inline-flex;
    align-items: center;
  }
  .breadcrumb li:not(:last-child)::after {
    content: "/";
    margin-left: 0.5rem;
    color: var(--color-border);
  }
  .breadcrumb a {
    color: var(--color-green-light);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }
  .blog-card {
    background: var(--color-dark-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }
  .blog-card:hover {
    transform: translateY(-5px);
    border-color: rgba(107, 190, 40, 0.5);
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  }
  .blog-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: rgba(255,255,255,0.05);
    overflow: hidden;
  }
  .blog-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .blog-card:hover .blog-image img {
    transform: scale(1.05);
  }
  .blog-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
  }
  .blog-content {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .blog-title {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-excerpt {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-excerpt :global(p) {
    margin: 0;
  }
  .blog-readmore {
    margin-top: auto;
    font-size: 0.875rem;
    color: var(--color-green-light);
    font-weight: 600;
  }
  .text-center { text-align: center; }
</style>
