---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Hero from "../../components/Hero.astro";
import PainPoints from "../../components/PainPoints.astro";
import Services from "../../components/Services.astro";
import Packages from "../../components/Packages.astro";
import Process from "../../components/Process.astro";
import TeamAction from "../../components/TeamAction.astro";
import FAQ from "../../components/FAQ.astro";
import Trust from "../../components/Trust.astro";
import BlogHome from "../../components/BlogHome.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";

export function getStaticPaths() {
  return [
    {
      params: { location: "sainoi" },
      props: {
        locationName: "ไทรน้อย",
        title: "รับดูแลระบบคอมพิวเตอร์ ไทรน้อย IT Support รายเดือน | BizGrow Tech",
        description: "บริการรับดูแลระบบคอมพิวเตอร์และเครือข่ายสำหรับองค์กรแบบรายเดือน โซนไทรน้อย นนทบุรี แก้ไขปัญหาไอที รวดเร็ว ลด Downtime โดยทีมงานมืออาชีพ",
        variant: 1,
        layoutOrder: ["PainPoints", "Services", "Packages", "Process", "TeamAction", "Trust", "FAQ"]
      },
    },
    {
      params: { location: "bangbuathong" },
      props: {
        locationName: "บางบัวทอง",
        title: "รับดูแลระบบคอมพิวเตอร์ บางบัวทอง IT Support รายเดือน | BizGrow Tech",
        description: "บริการ IT Support รับดูแลระบบคอมพิวเตอร์แบบรายเดือน ในพื้นที่บางบัวทอง นนทบุรี ป้องกันระบบล่ม ดูแลข้อมูลองค์กรอย่างมืออาชีพ",
        variant: 2,
        layoutOrder: ["Services", "PainPoints", "Process", "Packages", "FAQ", "Trust", "TeamAction"]
      },
    },
    {
      params: { location: "bangyai" },
      props: {
        locationName: "บางใหญ่",
        title: "รับดูแลระบบคอมพิวเตอร์ บางใหญ่ IT Support รายเดือน | BizGrow Tech",
        description: "หาทีมงาน IT Support ดูแลระบบคอมพิวเตอร์ โซนบางใหญ่ นนทบุรี แบบรายเดือน บริการรวดเร็ว แก้ปัญหาตรงจุด ไม่ต้องจ้างพนักงานประจำ",
        variant: 3,
        layoutOrder: ["Packages", "Services", "Process", "PainPoints", "Trust", "FAQ", "TeamAction"]
      },
    },
    {
      params: { location: "bangkruai" },
      props: {
        locationName: "บางกรวย",
        title: "รับดูแลระบบคอมพิวเตอร์ บางกรวย IT Support รายเดือน | BizGrow Tech",
        description: "รับดูแลระบบเครือข่ายและคอมพิวเตอร์สำหรับองค์กร โซนบางกรวย นนทบุรี บริการไอทีครบวงจร ลดต้นทุน เพิ่มประสิทธิภาพการทำงาน",
        variant: 4,
        layoutOrder: ["Services", "Packages", "PainPoints", "Trust", "Process", "TeamAction", "FAQ"]
      },
    },
  ];
}

const { locationName, title, description, variant, layoutOrder } = Astro.props;

const componentsMap: Record<string, any> = {
  PainPoints,
  Services,
  Packages,
  Process,
  TeamAction,
  Trust,
  FAQ
};
---

<Layout title={title} description={description}>
  <Navbar />
  <main id="main-content">
    <Hero location={locationName} variant={variant} />
    
    {layoutOrder.map((compName: string) => {
      const Component = componentsMap[compName];
      return Component ? <Component location={locationName} variant={variant} /> : null;
    })}

    <BlogHome />
    <Contact location={locationName} variant={variant} />
  </main>
  <Footer />
</Layout>
